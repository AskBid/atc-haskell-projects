-- tic-tac-toe.cabal
name:                tic-tac-toe
version:             0.1.0.0
description:         A game of tic-tac-toe
category:            CLI
build-type:          Simple
cabal-version:       >=1.10

library ghci
  exposed-modules:
    Board, Game, Main, TestGHCI, Graphics, Helpers, Interface, Interface.Game, Interface.AppState, Interface.Settings, Interface.Helpers, Parser, Ai
  hs-source-dirs:
    src
    ghci
  build-depends:
    base >= 4.7 && < 5,
    containers,
    ilist,
    parsec,
    mtl,
    random >= 1.1
  default-language: Haskell2010

executable tic-tac-toe
  main-is:             Main.hs
  hs-source-dirs:      src
  default-language:    Haskell2010
  build-depends:       base >=4.7 && <5
                     , containers
                     , ilist
                     , parsec
                     , mtl
                     , random >= 1.1
  other-modules:       Board, Game, Graphics, Helpers, Parser, Ai, Interface, Interface.Game, Interface.AppState, Interface.Settings, Interface.Helpers
